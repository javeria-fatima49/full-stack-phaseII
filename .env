# Environment Variables for Docker Compose
#
# Copy this file to .env and customize the values
# DO NOT commit .env to version control!

# ============================================================================
# Database Configuration
# ============================================================================

POSTGRES_DB=todo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ============================================================================
# Backend Configuration
# ============================================================================

BACKEND_PORT=8000
API_RELOAD=true
ENVIRONMENT=development
DEBUG=true

# JWT Configuration
JWT_SECRET=supersecretkeythatismorethan32characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://full-stack-phase-ii-j9ig.vercel.app/

# ============================================================================
# Frontend Configuration
# ============================================================================

FRONTEND_PORT=3000
NODE_ENV=development

# API URL (accessible from browser)
NEXT_PUBLIC_API_URL=https://javeriafatima-chatbot.hf.space

# Better Auth Configuration
BETTER_AUTH_SECRET=supersecretkeythatismorethan32characters
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# Development Settings
# ============================================================================

# Set to false to disable hot reload
HOT_RELOAD=true

# Set to false to enable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1