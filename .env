# Environment Variables for Docker Compose
#
# Copy this file to .env and customize the values
# DO NOT commit .env to version control!

# ============================================================================
# Database Configuration
# ============================================================================

POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=npg_0Oe1uvdXGDAt
POSTGRES_PORT=5432

# ============================================================================
# Backend Configuration
# ============================================================================

BACKEND_PORT=8000
API_RELOAD=true
ENVIRONMENT=development
DEBUG=true

# Database URL (using Neon connection string)
DATABASE_URL=postgresql://neondb_owner:npg_0Oe1uvdXGDAt@ep-super-voice-a42icjpb-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Configuration
JWT_SECRET=MySecureRandomString123456789012345678901234567890
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ============================================================================
# Frontend Configuration
# ============================================================================

FRONTEND_PORT=3000
NODE_ENV=development

# API URL (accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Better Auth Configuration
BETTER_AUTH_SECRET=MySecureRandomString123456789012345678901234567890
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# Development Settings
# ============================================================================

# Set to false to disable hot reload
HOT_RELOAD=true

# Set to false to enable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
