# Environment Variables Template
# Copy this file to .env.local and fill in actual values
# NEVER commit .env.local to version control

# Database (Required)
# Format: postgresql+asyncpg://user:password@host:port/database?ssl=require
# Development: Use local PostgreSQL or Docker
# Production: Get from Neon dashboard
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/todoapp

# Authentication (Required)
# Shared secret for JWT verification (must match frontend Better Auth secret)
# Generate with: openssl rand -base64 32
# MUST be at least 32 characters
BETTER_AUTH_SECRET=dGhpc2lzYWRldmVsb3BtZW50c2VjcmV0Zm9ydGVzdGluZw==

# Frontend URL (Required for CORS)
FRONTEND_URL=http://localhost:3000

# Server Configuration (Optional)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
RELOAD=true
WORKERS=1

# Logging (Optional)
LOG_LEVEL=DEBUG

# Database Pool (Optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# CORS Origins (Optional - comma-separated list)
# If not set, uses FRONTEND_URL
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
